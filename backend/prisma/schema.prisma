// =============================================================================
//  Schéma Prisma — Smart Ticketing & Support Assistant (Metavoria)
//  Entités nommées en français, fidèles au MCD validé.
//  Tables et colonnes mappées en snake_case (convention PostgreSQL).
// =============================================================================

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ─────────────────────────────────────────────────────────────────────────────
// Énumérations
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  EMPLOYE
  TECHNICIEN
  ADMINISTRATEUR
}

enum StatutTicket {
  NOUVEAU
  EN_COURS
  EN_ATTENTE
  RESOLU
  CLOTURE
}

enum Priorite {
  FAIBLE
  MOYENNE
  HAUTE
  CRITIQUE
}

// ─────────────────────────────────────────────────────────────────────────────
// Entités
// ─────────────────────────────────────────────────────────────────────────────

model Utilisateur {
  id     Int    @id @default(autoincrement())
  nom    String
  prenom String
  email  String @unique
  // Null tant que le compte invité n'a pas été activé (statut « En attente »).
  motDePasse String?  @map("mot_de_passe")
  role       Role     @default(EMPLOYE)
  service    String?
  poste      String?
  actif      Boolean  @default(true)
  dateCreation DateTime @default(now()) @map("date_creation")

  // Invitation par un administrateur : hash SHA-256 du token (jamais en clair),
  // lien valable 72 h. Effacés à l'activation du compte.
  tokenInvitation       String?   @unique @map("token_invitation")
  tokenInvitationExpire DateTime? @map("token_invitation_expire")

  // Réinitialisation de mot de passe par code OTP à 6 chiffres :
  // seul le hash SHA-256 du code est stocké ; validité 10 min ; 5 tentatives max.
  codeReinitialisation           String?   @map("code_reinitialisation")
  codeReinitialisationExpire     DateTime? @map("code_reinitialisation_expire")
  codeReinitialisationEmis       DateTime? @map("code_reinitialisation_emis")
  codeReinitialisationTentatives Int       @default(0) @map("code_reinitialisation_tentatives")

  // Relations
  ticketsDemandes  Ticket[]          @relation("TicketsDemandes")
  ticketsAssignes  Ticket[]          @relation("TicketsAssignes")
  commentaires     Commentaire[]
  evenementsTicket EvenementTicket[]
  notifications    Notification[]
  refreshTokens    RefreshToken[]

  @@map("utilisateurs")
}

// Jetons de rafraîchissement (sessions) : seul le hash SHA-256 du jeton opaque est
// stocké. Rotation à chaque usage (l'ancien est révoqué), révocation possible
// (déconnexion, désactivation) et détection de réutilisation d'un jeton déjà
// tourné (signale un vol → toute la famille de l'utilisateur est révoquée).
model RefreshToken {
  id            Int      @id @default(autoincrement())
  tokenHash     String   @unique @map("token_hash")
  expireLe      DateTime @map("expire_le")
  revoke        Boolean  @default(false)
  creeLe        DateTime @default(now()) @map("cree_le")

  utilisateurId Int         @map("utilisateur_id")
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId])
  @@map("refresh_tokens")
}

model Categorie {
  id          Int     @id @default(autoincrement())
  nom         String  @unique
  description String?

  tickets Ticket[]

  @@map("categories")
}

model Ticket {
  id               Int          @id @default(autoincrement())
  titre            String
  description      String
  statut           StatutTicket @default(NOUVEAU)
  priorite         Priorite     @default(MOYENNE)
  // Ticket issu du corpus synthétique (bootstrap IA) : exclu des KPI réels (§6.4).
  synthetique      Boolean      @default(false)
  dateCreation     DateTime     @default(now()) @map("date_creation")
  dateCloture      DateTime?    @map("date_cloture")
  satisfactionNote        Int?      @map("satisfaction_note") // 1..5, renseignée à la clôture
  satisfactionCommentaire String?   @map("satisfaction_commentaire") // retour libre optionnel du demandeur
  satisfactionDate        DateTime? @map("satisfaction_date") // horodatage de l'évaluation

  // Embedding du ticket pour la recherche de similarité (module IA, phase 5).
  // Dimension 1024 = bge-m3 (modèle retenu J4). L'index HNSW cosinus est créé en
  // SQL brut dans la migration (Prisma ne sait pas exprimer un index HNSW).
  embedding       Unsupported("vector(1024)")?
  embeddingModele String?                      @map("embedding_modele") // repro : modèle/version ayant produit le vecteur

  categorieId Int? @map("categorie_id")
  categorie   Categorie? @relation(fields: [categorieId], references: [id], onDelete: SetNull)

  demandeurId Int @map("demandeur_id")
  demandeur   Utilisateur @relation("TicketsDemandes", fields: [demandeurId], references: [id])

  technicienId Int? @map("technicien_id")
  technicien   Utilisateur? @relation("TicketsAssignes", fields: [technicienId], references: [id], onDelete: SetNull)

  commentaires  Commentaire[]
  piecesJointes PieceJointe[]
  suggestionsIA SuggestionIA[]
  evenements    EvenementTicket[]
  notifications Notification[]

  @@index([statut])
  @@index([priorite])
  @@index([demandeurId])
  @@index([technicienId])
  @@index([categorieId])
  @@map("tickets")
}

model Commentaire {
  id           Int      @id @default(autoincrement())
  contenu      String
  dateCreation DateTime @default(now()) @map("date_creation")

  ticketId Int    @map("ticket_id")
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  auteurId Int         @map("auteur_id")
  auteur   Utilisateur @relation(fields: [auteurId], references: [id])

  @@index([ticketId])
  @@map("commentaires")
}

model PieceJointe {
  id         Int      @id @default(autoincrement())
  nomFichier String   @map("nom_fichier")
  url        String
  dateUpload DateTime @default(now()) @map("date_upload")

  ticketId Int    @map("ticket_id")
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("pieces_jointes")
}

model Notification {
  id        Int      @id @default(autoincrement())
  type      String // ex. CHANGEMENT_STATUT, AFFECTATION, NOUVEAU_COMMENTAIRE
  contenu   String
  lu        Boolean  @default(false)
  dateEnvoi DateTime @default(now()) @map("date_envoi")

  utilisateurId Int         @map("utilisateur_id")
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  // Ticket concerné : permet au clic sur la notification de rediriger vers le ticket.
  // Optionnel pour rester compatible avec d'éventuelles notifications non liées à un ticket.
  ticketId Int?    @map("ticket_id")
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([utilisateurId, lu])
  @@map("notifications")
}

// Historique des changements d'un ticket (statut, priorité, affectation), affiché
// dans le fil de conversation à côté des commentaires. Sert aussi de trace d'audit
// consultable dans l'application (exigence non fonctionnelle « Traçabilité »).
model EvenementTicket {
  id             Int      @id @default(autoincrement())
  type           String // CHANGEMENT_STATUT | CHANGEMENT_PRIORITE | AFFECTATION | DESAFFECTATION
  ancienneValeur String?  @map("ancienne_valeur")
  nouvelleValeur String?  @map("nouvelle_valeur")
  dateCreation   DateTime @default(now()) @map("date_creation")

  ticketId Int    @map("ticket_id")
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  auteurId Int         @map("auteur_id")
  auteur   Utilisateur @relation(fields: [auteurId], references: [id])

  @@index([ticketId])
  @@map("evenements_ticket")
}

// Prévu dans le schéma dès maintenant ; la logique IA sera implémentée en phase 5.
model SuggestionIA {
  id             Int      @id @default(autoincrement())
  typeSuggestion String   @map("type_suggestion") // CLASSIFICATION | PRIORISATION | SOLUTION | RESUME
  contenu        String
  scoreConfiance Float    @map("score_confiance") // 0..1, affiché au technicien (validation humaine obligatoire)
  valideeParTechnicien Boolean? @map("validee_par_technicien")
  dateCreation   DateTime @default(now()) @map("date_creation")

  ticketId Int    @map("ticket_id")
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("suggestions_ia")
}

# =============================================================================
#  Smart Ticketing & Support Assistant — Variables d'environnement (racine)
#  Ce fichier est consommé par docker-compose. Copie-le en `.env` :
#     cp .env.example .env
#  Pour le développement local hors Docker, vois aussi backend/.env.example
#  et frontend/.env.example.
# =============================================================================

# ── PostgreSQL (+ pgvector) ─────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_ticketing
POSTGRES_PORT=5432

# ── Backend (API Express) ───────────────────────────────────────────────────
BACKEND_PORT=4000
NODE_ENV=development

# URL de connexion Prisma.
# En local (npm run dev)     -> host = localhost
# Dans docker-compose        -> host = postgres (surchargé automatiquement)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_ticketing?schema=public

# Secret JWT : REMPLACE cette valeur par une chaîne aléatoire d'au moins 32 caractères.
# Génère-en une avec :  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_super_secret_key_of_at_least_32_characters
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Origine autorisée pour le CORS (frontend)
CORS_ORIGIN=http://localhost:5173

# ── Frontend (React + Vite) ─────────────────────────────────────────────────
FRONTEND_PORT=5173
# Base des appels API. En Docker, nginx proxifie /api -> backend, donc "/api".
VITE_API_URL=/api

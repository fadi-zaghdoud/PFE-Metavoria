// =============================================================================
//  Schéma Prisma — Smart Ticketing & Support Assistant (Metavoria)
//  Entités nommées en français, fidèles au MCD validé.
//  Tables et colonnes mappées en snake_case (convention PostgreSQL).
// =============================================================================

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ─────────────────────────────────────────────────────────────────────────────
// Énumérations
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  EMPLOYE
  TECHNICIEN
  ADMINISTRATEUR
}

enum StatutTicket {
  NOUVEAU
  EN_COURS
  EN_ATTENTE
  RESOLU
  CLOTURE
}

enum Priorite {
  FAIBLE
  MOYENNE
  HAUTE
  CRITIQUE
}

// ─────────────────────────────────────────────────────────────────────────────
// Entités
// ─────────────────────────────────────────────────────────────────────────────

model Utilisateur {
  id           Int      @id @default(autoincrement())
  nom          String
  prenom       String
  email        String   @unique
  // Null tant que le compte invité n'a pas été activé (statut « En attente »).
  motDePasse   String?  @map("mot_de_passe")
  role         Role     @default(EMPLOYE)
  service      String?
  poste        String?
  actif        Boolean  @default(true)
  dateCreation DateTime @default(now()) @map("date_creation")

  // Invitation par un administrateur : hash SHA-256 du token (jamais en clair),
  // lien valable 72 h. Effacés à l'activation du compte.
  tokenInvitation       String?   @unique @map("token_invitation")
  tokenInvitationExpire DateTime? @map("token_invitation_expire")

  // Réinitialisation de mot de passe par code OTP à 6 chiffres :
  // seul le hash SHA-256 du code est stocké ; validité 10 min ; 5 tentatives max.
  codeReinitialisation           String?   @map("code_reinitialisation")
  codeReinitialisationExpire     DateTime? @map("code_reinitialisation_expire")
  codeReinitialisationEmis       DateTime? @map("code_reinitialisation_emis")
  codeReinitialisationTentatives Int       @default(0) @map("code_reinitialisation_tentatives")

  // Relations
  ticketsDemandes    Ticket[]              @relation("TicketsDemandes")
  ticketsAssignes    Ticket[]              @relation("TicketsAssignes")
  commentaires       Commentaire[]
  evenementsTicket   EvenementTicket[]
  notifications      Notification[]
  refreshTokens      RefreshToken[]
  // Affectation automatique (§6.2) : specialites du technicien, ses absences,
  // les absences qu'il a saisies (admin) et les parametres qu'il a modifies.
  specialites        TechnicienCategorie[]
  absences           Absence[]             @relation("AbsencesTechnicien")
  absencesSaisies    Absence[]             @relation("AbsencesSaisies")
  parametresModifies Parametre[]

  @@map("utilisateurs")
}

// Jetons de rafraîchissement (sessions) : seul le hash SHA-256 du jeton opaque est
// stocké. Rotation à chaque usage (l'ancien est révoqué), révocation possible
// (déconnexion, désactivation) et détection de réutilisation d'un jeton déjà
// tourné (signale un vol → toute la famille de l'utilisateur est révoquée).
model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash")
  expireLe  DateTime @map("expire_le")
  revoke    Boolean  @default(false)
  creeLe    DateTime @default(now()) @map("cree_le")

  utilisateurId Int         @map("utilisateur_id")
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId])
  @@map("refresh_tokens")
}

model Categorie {
  id           Int      @id @default(autoincrement())
  nom          String   @unique
  description  String?
  // Horodatage de création (Phase A — cycle de vie des catégories) : sert à afficher
  // « en apprentissage depuis … » côté admin. Le STATUT (en apprentissage / apprenable /
  // active) reste CALCULÉ (classes du modèle IA vs base + compteur de labels), jamais stocké.
  dateCreation DateTime @default(now()) @map("date_creation")

  tickets     Ticket[]
  // Techniciens declares specialistes de cette categorie (affectation automatique §6.2).
  techniciens TechnicienCategorie[]

  @@map("categories")
}

model Ticket {
  id                      Int          @id @default(autoincrement())
  titre                   String
  description             String
  statut                  StatutTicket @default(NOUVEAU)
  priorite                Priorite     @default(MOYENNE)
  // Ticket issu du corpus synthétique (bootstrap IA) : exclu des KPI réels (§6.4).
  synthetique             Boolean      @default(false)
  dateCreation            DateTime     @default(now()) @map("date_creation")
  dateCloture             DateTime?    @map("date_cloture")
  satisfactionNote        Int?         @map("satisfaction_note") // 1..5, renseignée à la clôture
  satisfactionCommentaire String?      @map("satisfaction_commentaire") // retour libre optionnel du demandeur
  satisfactionDate        DateTime?    @map("satisfaction_date") // horodatage de l'évaluation

  // Solution appliquée, SAISIE PAR LE TECHNICIEN à la résolution (module IA, K1). Facultative :
  // un ticket résolu sans solution reste hors KB. Sa présence (resolution IS NOT NULL) fait
  // entrer le ticket RÉEL dans la base de connaissances du RAG (exclut naturellement le bruit
  // de dev, qui n'en a pas). Le RAG la cite comme « source réelle » (texte du doc, pas la recherche).
  resolution     String?   @map("resolution")
  resolutionDate DateTime? @map("resolution_date")

  // Embedding du ticket pour la recherche de similarité (module IA, phase 5).
  // Dimension 1024 = bge-m3 (modèle retenu J4). L'index HNSW cosinus est créé en
  // SQL brut dans la migration (Prisma ne sait pas exprimer un index HNSW).
  embedding       Unsupported("vector(1024)")?
  embeddingModele String?                      @map("embedding_modele") // repro : modèle/version ayant produit le vecteur

  // Recherche plein-texte (module IA, J6 — arm lexical de la recherche hybride RRF).
  // Colonne tsvector GÉNÉRÉE STORED (titre + description, config 'french') + index GIN,
  // créées en SQL brut dans la migration : Prisma ne sait exprimer ni une colonne
  // générée ni un index GIN sur tsvector. Toujours en phase, jamais écrite par Node.
  rechercheTexte Unsupported("tsvector")? @map("recherche_texte")

  categorieId Int?       @map("categorie_id")
  categorie   Categorie? @relation(fields: [categorieId], references: [id], onDelete: SetNull)

  demandeurId Int         @map("demandeur_id")
  demandeur   Utilisateur @relation("TicketsDemandes", fields: [demandeurId], references: [id])

  technicienId Int?         @map("technicien_id")
  technicien   Utilisateur? @relation("TicketsAssignes", fields: [technicienId], references: [id], onDelete: SetNull)

  commentaires  Commentaire[]
  piecesJointes PieceJointe[]
  suggestionsIA SuggestionIA[]
  evenements    EvenementTicket[]
  notifications Notification[]

  @@index([statut])
  @@index([priorite])
  @@index([demandeurId])
  @@index([technicienId])
  @@index([categorieId])
  @@map("tickets")
}

model Commentaire {
  id           Int      @id @default(autoincrement())
  contenu      String
  dateCreation DateTime @default(now()) @map("date_creation")

  ticketId Int    @map("ticket_id")
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  auteurId Int         @map("auteur_id")
  auteur   Utilisateur @relation(fields: [auteurId], references: [id])

  @@index([ticketId])
  @@map("commentaires")
}

model PieceJointe {
  id           Int      @id @default(autoincrement())
  nomFichier   String   @map("nom_fichier")
  url          String // URL Cloudinary (secure_url)
  cloudinaryId String?  @map("cloudinary_id") // public_id Cloudinary (suppression)
  typeMime     String?  @map("type_mime")
  taille       Int? // octets
  // Texte extrait par OCR (J8bis, Lot B) — rempli après extraction si confiance suffisante ;
  // JAMAIS injecté dans `description` (augmentation à l'usage). Vide jusqu'au Lot B.
  texteExtrait String?  @map("texte_extrait")
  dateUpload   DateTime @default(now()) @map("date_upload")

  ticketId Int    @map("ticket_id")
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("pieces_jointes")
}

model Notification {
  id        Int      @id @default(autoincrement())
  type      String // ex. CHANGEMENT_STATUT, AFFECTATION, NOUVEAU_COMMENTAIRE
  contenu   String
  lu        Boolean  @default(false)
  dateEnvoi DateTime @default(now()) @map("date_envoi")

  utilisateurId Int         @map("utilisateur_id")
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  // Ticket concerné : permet au clic sur la notification de rediriger vers le ticket.
  // Optionnel pour rester compatible avec d'éventuelles notifications non liées à un ticket.
  ticketId Int?    @map("ticket_id")
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([utilisateurId, lu])
  @@map("notifications")
}

// Historique des changements d'un ticket (statut, priorité, affectation), affiché
// dans le fil de conversation à côté des commentaires. Sert aussi de trace d'audit
// consultable dans l'application (exigence non fonctionnelle « Traçabilité »).
model EvenementTicket {
  id             Int      @id @default(autoincrement())
  type           String // CHANGEMENT_STATUT | CHANGEMENT_PRIORITE | AFFECTATION | DESAFFECTATION
  ancienneValeur String?  @map("ancienne_valeur")
  nouvelleValeur String?  @map("nouvelle_valeur")
  dateCreation   DateTime @default(now()) @map("date_creation")

  ticketId Int    @map("ticket_id")
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Nullable depuis l'affectation automatique : une affectation decidee par le SYSTEME
  // (mode AUTO, a la creation) n'a pas d'auteur humain -> NULL, affiche « Systeme ».
  // onDelete: Restrict (et non SET NULL) : NULL doit signifier « Systeme » et RIEN
  // d'autre. Sans cette garde, supprimer un compte relabelliserait ses actions
  // passees en actions systeme — une trace d'audit qui ment.
  auteurId Int?         @map("auteur_id")
  auteur   Utilisateur? @relation(fields: [auteurId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@map("evenements_ticket")
}

// Suggestion produite par le module IA (Greffe 1 : CLASSIFICATION, PRIORISATION ;
// Greffes suivantes : SOLUTION, RESUME). L'IA SUGGÈRE, elle n'impose pas : le
// technicien valide/corrige (via changerCategorie/changerPriorite), ce qui alimente
// le flywheel J9 (comparaison « suggéré X / choisi Y »).
model SuggestionIA {
  id                   Int      @id @default(autoincrement())
  typeSuggestion       String   @map("type_suggestion") // CLASSIFICATION | PRIORISATION | SOLUTION | RESUME
  // Origine (Greffe 3, flywheel) : 'creation' (à la création) | 'apres_ocr' (ré-évaluation
  // après OCR d'une pièce jointe). Colonne dédiée (auparavant dans `details.origine`) pour
  // requêter les métriques « suggéré vs choisi » par origine.
  origine              String?  @map("origine")
  contenu              String // valeur suggérée : nom de catégorie, niveau de priorité, …
  // Proba top-1 (classification) ; NULL pour la scorecard déterministe (priorité :
  // règle glass-box sans probabilité — on ne fabrique pas de fausse confiance).
  scoreConfiance       Float?   @map("score_confiance")
  // Détail structuré : probabilités par classe (classification) OU décomposition
  // glass-box de la scorecard (priorité) OU sources+similaires (solution RAG).
  details              Json?
  // Cycle de la suggestion. PRETE d'emblée pour les suggestions SYNCHRONES
  // (CLASSIFICATION/PRIORISATION, Greffe 1). Pour la SOLUTION RAG (Greffe 2, générée
  // en ASYNCHRONE 15-30 s) : EN_COURS → PRETE (texte + sources) ou ECHEC.
  statut               String   @default("PRETE")
  valideeParTechnicien Boolean? @map("validee_par_technicien")
  dateCreation         DateTime @default(now()) @map("date_creation")

  ticketId Int    @map("ticket_id")
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("suggestions_ia")
}

// ─────────────────────────────────────────────────────────────────────────────
// Affectation automatique des tickets (§6.2) — Chantier 1
// ─────────────────────────────────────────────────────────────────────────────

// Motif d'absence — ÉNUMÉRATION et non texte libre : filtrable, agrégeable, sans
// variantes orthographiques (le champ `service` en texte libre a déjà montré cette
// limite : impossible à joindre de façon fiable). Le `commentaire` optionnel de
// `Absence` récupère l'expressivité perdue (« congé parental », « formation K8s »).
enum MotifAbsence {
  CONGE
  MALADIE
  FORMATION
  AUTRE
}

// Configuration applicative persistante, en CLÉ-VALEUR. Accueille aujourd'hui le mode
// d'affectation (MANUEL | AUTO) et, plus tard, les seuils IA réglables (§6.5) — un
// nouveau réglage coûte alors UNE LIGNE, pas une migration.
// Le typage perdu par le clé-valeur est repris par un REGISTRE côté service (clés
// connues, défaut, parseur, validation) : clé inconnue rejetée, valeur illisible →
// défaut. La lecture ne lève jamais et retombe toujours sur le comportement sûr.
model Parametre {
  cle         String   @id
  valeur      String
  description String?
  dateMaj     DateTime @updatedAt @map("date_maj")

  // Qui a modifié le réglage en dernier (NULL = valeur posée par défaut/seed).
  majParId Int?         @map("maj_par_id")
  majPar   Utilisateur? @relation(fields: [majParId], references: [id])

  @@map("parametres")
}

// Spécialité d'un technicien : quelles CATÉGORIES de tickets il couvre (N-N).
// Table de liaison EXPLICITE (et non le N-N implicite de Prisma) : nommable dans le
// MCD, et extensible (un niveau d'expertise pourrait s'y ajouter sans refonte).
// Suppression en cascade des deux côtés : un lien de spécialité n'a aucun sens sans
// son technicien ni sans sa catégorie (la suppression de catégorie est exposée en admin).
model TechnicienCategorie {
  technicienId Int         @map("technicien_id")
  technicien   Utilisateur @relation(fields: [technicienId], references: [id], onDelete: Cascade)

  categorieId Int       @map("categorie_id")
  categorie   Categorie @relation(fields: [categorieId], references: [id], onDelete: Cascade)

  dateAjout DateTime @default(now()) @map("date_ajout")

  @@id([technicienId, categorieId])
  @@index([categorieId])
  @@map("technicien_categories")
}

// Absence d'un technicien (congé, maladie, formation) — l'exclut des candidats à
// l'AFFECTATION AUTOMATIQUE, sans jamais toucher à son accès applicatif : `actif`
// reste un mécanisme DISTINCT (il coupe la connexion, pour un départ, pas un congé).
// Ses tickets déjà assignés ne bougent pas.
//
// `@db.Date` et NON `DateTime` : une absence est un INTERVALLE DE CALENDRIER, pas un
// instant. En timestamp, `dateFin = 20/08 00:00` ne couvrirait pas le 20 — toute la
// classe de bugs de bornes disparaît avec une date pure. Bornes INCLUSES des deux côtés.
//
// `dateFin` OBLIGATOIRE : une absence ouverte est précisément l'oubli que la table
// datée sert à éviter (le technicien redevient disponible tout seul à son retour).
// Une durée inconnue se saisit avec une fin plausible, quitte à la prolonger.
//
// Pas de `dateMaj`/`modifieParId` : la traçabilité des modifications relève de la
// table d'audit du Chantier 2 — ne pas dupliquer un mécanisme sur le point d'exister.
model Absence {
  id Int @id @default(autoincrement())

  technicienId Int         @map("technicien_id")
  technicien   Utilisateur @relation("AbsencesTechnicien", fields: [technicienId], references: [id], onDelete: Cascade)

  dateDebut DateTime @map("date_debut") @db.Date
  dateFin   DateTime @map("date_fin") @db.Date

  motif       MotifAbsence
  // Précision libre facultative — jamais exposée hors de l'administration :
  // MALADIE est une donnée de santé, et le graphique de charge du tableau de bord
  // est visible par TOUS les techniciens (garde `estSupport`), pas par l'admin seul.
  commentaire String?

  // Qui a saisi l'absence (administrateur). Pas de cascade : on ne perd pas
  // silencieusement l'information de saisie si le compte est supprimé.
  creeParId Int         @map("cree_par_id")
  creePar   Utilisateur @relation("AbsencesSaisies", fields: [creeParId], references: [id])

  dateCreation DateTime @default(now()) @map("date_creation")

  // Sert la recherche « absent aujourd'hui » ET le contrôle de chevauchement.
  @@index([technicienId, dateDebut, dateFin])
  @@map("absences")
}

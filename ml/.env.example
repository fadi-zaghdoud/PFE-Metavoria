# Copie en `.env` (non committé). Le module IA ne fait AUCUN appel externe :
# tout tourne en local (Postgres + Ollama).

# Base de données — lecture read-only des catégories (table `categories`).
# Doit pointer sur la même base que le backend (voir backend/.env).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_ticketing

# LLM local (service `ollama` du docker-compose).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_MODEL_FALLBACK=qwen2.5:7b

# Service d'embeddings (J4) — bge-m3 auto-hébergé, 1024d. Tout est local.
EMBED_MODELE=BAAI/bge-m3
EMBED_DEVICE=cpu          # `cuda` en prod si l'embed à la volée est trop lent en CPU
EMBED_HOTE=127.0.0.1
EMBED_PORT=8000

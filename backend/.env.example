# =============================================================================
#  Backend — variables d'environnement pour le développement LOCAL (npm run dev)
#  Copie ce fichier en `backend/.env` :  cp backend/.env.example backend/.env
#  (En Docker, ces valeurs sont fournies par docker-compose.)
# =============================================================================

NODE_ENV=development
PORT=4000

# Prisma se connecte au Postgres local (démarre-le via `docker compose up -d postgres`)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_ticketing?schema=public

# Secret JWT — OBLIGATOIRE, au moins 32 caractères aléatoires.
# La valeur ci-dessous est volontairement REFUSÉE (trop courte) : tant qu'elle n'est pas
# remplacée, le serveur refuse de démarrer, plutôt que de tourner avec un secret public.
# Génère-en une avec :  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#                  ou :  openssl rand -hex 48
JWT_SECRET=a_remplacer
# Session courte (haute sécurité) : access token JWT court + refresh token rotatif (cookie httpOnly)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_SALT_ROUNDS=12

# Origine autorisée pour le CORS (frontend Vite)
CORS_ORIGIN=http://localhost:5173

# URL du frontend — utilisée pour construire le lien de réinitialisation de mot de passe
FRONTEND_URL=http://localhost:5173

# ── SMTP (envoi d'e-mails, ex. réinitialisation de mot de passe) ───────────
# LAISSÉS VIDES, l'application fonctionne sans e-mail : le lien d'invitation, le code de
# réinitialisation et les notifications sont écrits dans la console du serveur. Ne les
# remplis qu'avec de vrais identifiants : une valeur d'exemple ferait croire le SMTP
# configuré, et chaque envoi échouerait.
# Exemple avec Gmail : active la validation en 2 étapes sur le compte, puis génère
# un "mot de passe d'application" dédié (https://myaccount.google.com/apppasswords)
# — n'utilise JAMAIS ton mot de passe Google principal ici.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Smart Ticketing <no-reply@metavoria.tn>"

# ── Module IA — cycle de vie des catégories (Phase A) ──────────────────────
# Seuil de labels validés (tickets réels RESOLU/CLOTURE) au-delà duquel une catégorie
# encore inconnue du modèle passe « apprenable ». Optionnel (défaut 10).
SEUIL_EXEMPLES_APPRENABLE=10

# ── Cloudinary (stockage des pièces jointes, J8bis) ────────────────────────
# Récupère ces 3 valeurs sur ton Dashboard Cloudinary (https://console.cloudinary.com/,
# section "Product Environment Credentials"). LAISSÉES VIDES, l'upload est désactivé
# proprement ; une valeur d'exemple ferait croire le stockage configuré, et chaque envoi
# de fichier échouerait.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =============================================================================
#  Smart Ticketing & Support Assistant — Variables d'environnement (racine)
#  Ce fichier est consommé par docker-compose. Copie-le en `.env` :
#     cp .env.example .env
#  Pour le développement local hors Docker, vois aussi backend/.env.example
#  et frontend/.env.example.
# =============================================================================

# ── PostgreSQL (+ pgvector) ─────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_ticketing
POSTGRES_PORT=5432

# ── Backend (API Express) ───────────────────────────────────────────────────
BACKEND_PORT=4000
NODE_ENV=development

# URL de connexion Prisma.
# En local (npm run dev)     -> host = localhost
# Dans docker-compose        -> host = postgres (surchargé automatiquement)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_ticketing?schema=public

# Secret JWT — OBLIGATOIRE, au moins 32 caractères aléatoires.
# La valeur ci-dessous est volontairement REFUSÉE (trop courte) : tant qu'elle n'est pas
# remplacée, le backend refuse de démarrer, plutôt que de tourner avec un secret public.
# Génère-en une avec :  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#                  ou :  openssl rand -hex 48
JWT_SECRET=a_remplacer
BCRYPT_SALT_ROUNDS=12

# Origine autorisée pour le CORS (frontend)
CORS_ORIGIN=http://localhost:5173

# URL du frontend — utilisée pour construire le lien de réinitialisation de mot de passe
FRONTEND_URL=http://localhost:5173

# ── SMTP (envoi d'e-mails, ex. réinitialisation de mot de passe) ───────────
# LAISSÉS VIDES, l'application fonctionne sans e-mail : le lien d'invitation, le code de
# réinitialisation et les notifications sont écrits dans les logs du backend
# (`docker compose logs backend`). Ne les remplis qu'avec de vrais identifiants : une
# valeur d'exemple ferait croire le SMTP configuré, et chaque envoi échouerait.
# Exemple avec Gmail : active la validation en 2 étapes, puis génère un
# "mot de passe d'application" dédié (https://myaccount.google.com/apppasswords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Smart Ticketing <no-reply@metavoria.tn>"

# ── Frontend (React + Vite) ─────────────────────────────────────────────────
FRONTEND_PORT=5173
# Base des appels API. En Docker, nginx proxifie /api -> backend, donc "/api".
VITE_API_URL=/api

# ── Sessions à jetons courts (durcissement sécurité) ────────────────────────
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── Administrateur initial (premier déploiement) ────────────────────────────
# Lus par le seed au démarrage du backend. Ils créent le PREMIER administrateur
# — et seulement lui : dès qu'un administrateur existe en base, ces variables
# n'ont plus aucun effet. Elles ne permettent donc pas de reprendre la main sur
# une instance en service. Laisser vide = aucun compte créé (pas d'identifiants
# par défaut livrés avec le produit). Mot de passe : 12 caractères minimum.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Pièces jointes — Cloudinary (J8bis lot A) ───────────────────────────────
# Sans ces trois valeurs, l'application démarre mais l'upload est DÉSACTIVÉ,
# donc l'OCR (lot B) n'a rien à traiter.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Module IA (Epic 4) — service Python + Ollama ────────────────────────────
# Port publié du microservice IA (le backend, lui, l'atteint par http://ml:8000).
ML_PORT=8000

# Interrupteur global de la greffe IA : `false` coupe tout (tickets créés sans
# catégorie/priorité automatiques). L'IA est NON BLOQUANTE dans tous les cas.
IA_ACTIVE=true
# Budget par appel synchrone (création de ticket) — borne la latence ajoutée.
IA_TIMEOUT_MS=4000
# Appels ASYNCHRONES : génération RAG, OCR d'une pièce jointe, flywheel admin.
IA_SUGGESTION_TIMEOUT_MS=60000
IA_EXTRACT_TIMEOUT_MS=60000
IA_REENTRAINEMENT_TIMEOUT_MS=30000
# Nombre de labels validés à partir duquel une catégorie inconnue du modèle
# devient « apprenable » (signal admin « prête à réentraîner »).
SEUIL_EXEMPLES_APPRENABLE=10

# Modèle de génération du service IA (RAG et résumés). qwen2.5:7b est le DÉFAUT,
# choisi sur mesures (voir journal, Phase 7) : il tient le budget de 60 s PARTOUT,
# GPU ou non — 28,8 s en CPU pur, contre 62,8 s pour le 14b qui, lui, dépasse.
# Sur les deux tâches du produit (reformulation ancrée sur le RAG, résumé de fil,
# c'est-à-dire de la SYNTHÈSE CADRÉE) sa qualité s'est révélée au niveau du 14b.
OLLAMA_MODEL=qwen2.5:7b
# Concerne UNIQUEMENT la génération de corpus J1 (CLI), pas le service.
OLLAMA_MODEL_FALLBACK=qwen2.5:7b

# Modèles provisionnés automatiquement dans le conteneur Ollama par le service
# one-shot `ollama-prefetch` (~13 Go au tout premier démarrage, puis en cache).
# Le principal est tiré en premier. Le 14b reste provisionné : il demeure une
# option pour qui dispose d'un GPU (voir docker-compose.gpu.yml) — il passe alors
# à 43,6 s — et il sert la génération de corpus J1.
OLLAMA_MODELES=qwen2.5:7b qwen2.5:14b

# Durée de rétention du modèle en mémoire par Ollama. `-1` = indéfiniment : le
# chargement (18,7 s en CPU) n'est payé qu'une fois, au démarrage de la pile, par
# le provisionnement. Sans ce réglage, Ollama décharge au bout de 5 min et la
# requête suivante repaie le chargement (mesuré : 83,0 s au lieu de 62,8 s).
OLLAMA_KEEP_ALIVE=-1

# Où le service IA joint Ollama. Par DÉFAUT : le conteneur de la pile — c'est ce
# qui rend le déploiement AUTONOME (aucune installation préalable sur le serveur).
ML_OLLAMA_HOST=http://ollama:11434
# Variante de DÉVELOPPEMENT seulement, pour réutiliser un Ollama déjà installé sur
# la machine et éviter de retélécharger les modèles :
#   ML_OLLAMA_HOST=http://host.docker.internal:11434
# À ne PAS utiliser en livraison : ce nom ne résout pas sur un serveur Linux sans
# `extra_hosts: host-gateway`.

# Device d'inférence des modèles auto-hébergés. `cuda` en production si l'embed à
# la volée devient trop lent — aucune ligne de code applicatif ne change (Phase 7).
EMBED_DEVICE=cpu
RERANK_DEVICE=cpu
# Langue OCR (pack Tesseract `fra` installé dans l'image du service IA).
OCR_LANGUE=fra
